// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  role          String    @default("USER") // USER, ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teams         TeamUser[]
  monitors      Monitor[] // Monitors owned by user directly
  statusPages   StatusPage[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
}

model Team {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TeamUser[]
  monitors    Monitor[]
  statusPages StatusPage[]
}

model TeamUser {
  id        String   @id @default(cuid())
  role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Monitor {
  id              String   @id @default(cuid())
  name            String
  url             String
  type            String   @default("HTTP") // HTTP, PING, HEARTBEAT
  method          String   @default("GET")
  interval        Int      @default(60) // in seconds
  expectedStatus  Int?     @default(200)
  expectedKeyword String?
  headers         String?  // JSON string
  body            String?  // JSON string
  timeout         Int      @default(10000) // in ms
  retries         Int      @default(3)

  status          String   @default("UP") // UP, DOWN, PAUSED
  lastChecked     DateTime?
  nextRunAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId          String?
  teamId          String?

  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  logs            MonitorLog[]
  incidents       Incident[]
  alertRules      AlertRule[]
  maintenanceWindows MaintenanceWindow[]
}

model MonitorLog {
  id            String   @id @default(cuid())
  monitorId     String
  status        String   // UP, DOWN
  statusCode    Int?
  responseTime  Int?     // in ms
  errorMessage  String?
  createdAt     DateTime @default(now())

  monitor       Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, createdAt])
}

model Incident {
  id            String   @id @default(cuid())
  monitorId     String
  status        String   @default("ONGOING") // ONGOING, RESOLVED
  title         String
  description   String?
  startedAt     DateTime @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  monitor       Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  updates       IncidentUpdate[]
}

model IncidentUpdate {
  id            String   @id @default(cuid())
  incidentId    String
  message       String
  status        String   // INVESTIGATING, IDENTIFIED, MONITORING, RESOLVED
  createdAt     DateTime @default(now())

  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model AlertRule {
  id            String   @id @default(cuid())
  monitorId     String
  type          String   // EMAIL, WEBHOOK
  target        String   // Email address or webhook URL
  createdAt     DateTime @default(now())

  monitor       Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
}

model StatusPage {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  monitors      String   // JSON string of monitor IDs included in this page
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String?
  teamId        String?

  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  team          Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id            String   @id @default(cuid())
  name          String
  key           String   @unique
  userId        String
  createdAt     DateTime @default(now())
  lastUsed      DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MaintenanceWindow {
  id            String    @id @default(cuid())
  monitorId     String
  title         String
  startTime     DateTime
  endTime       DateTime
  createdAt     DateTime  @default(now())

  monitor       Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String    @id @default(cuid())
  userId        String?
  action        String
  details       String?   // JSON string
  ipAddress     String?
  createdAt     DateTime  @default(now())

  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}